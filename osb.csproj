<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>c5e9c2ed-233c-4552-b7a2-8cdaec0e7d88</UserSecretsId>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The C# tests are a separate project in Tests/, inside this folder. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the tests reach internals such as the seeder's stream overload. -->
    <InternalsVisibleTo Include="osb.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Initial showcase data, inserted by ShowcaseSeeder; embedded so it never ships as a loose file. -->
    <Content Remove="Data\Seed\showcase.json" />
    <EmbeddedResource Include="Data\Seed\showcase.json" LogicalName="osb.Data.Seed.showcase.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The learn course (Markdown + YAML), read at startup by Learn/CourseLoader.cs. -->
    <Content Include="Content\Learn\**\*" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.12" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!--
    Frontend: `npm run build` produces wwwroot/css, wwwroot/js and wwwroot/fonts (needs Node.js 20+).
    It runs before the SDK collects wwwroot assets, and only when an input changed.
    Use -p:SkipFrontend=true to reuse existing output, e.g. on a machine without Node.
  -->
  <ItemGroup>
    <FrontendInput Include="package.json;package-lock.json;Styles\**\*;Scripts\**\*;Views\**\*.cshtml;Content\**\*;Learn\**\*.cs" Exclude="Scripts\tests\**" />
  </ItemGroup>

  <Target Name="NpmInstall" Condition="'$(SkipFrontend)' != 'true' and '$(DesignTimeBuild)' != 'true'" Inputs="package.json;package-lock.json" Outputs="node_modules\.package-lock.json">
    <Exec Command="npm ci --no-audit --no-fund" />
  </Target>

  <Target Name="BuildFrontend" BeforeTargets="ResolveProjectStaticWebAssets" DependsOnTargets="NpmInstall" Condition="'$(SkipFrontend)' != 'true' and '$(DesignTimeBuild)' != 'true'" Inputs="@(FrontendInput)" Outputs="$(IntermediateOutputPath)frontend.stamp">
    <Exec Command="npm run build" />
    <Touch Files="$(IntermediateOutputPath)frontend.stamp" AlwaysCreate="true" />
  </Target>

  <!--
    On a clean checkout these files don't exist yet when MSBuild lists wwwroot, so add them here.
    A rebuild can also rename chunks (their names carry a hash of their content), so drop the files
    that are gone.
  -->
  <Target Name="IncludeFrontendOutput" AfterTargets="BuildFrontend">
    <ItemGroup>
      <_StaleFrontendOutput Include="@(Content)" Condition="!Exists('%(Content.FullPath)')" />
      <Content Remove="@(_StaleFrontendOutput)" />
      <_FrontendOutput Include="wwwroot\css\app.css;wwwroot\css\fonts.css;wwwroot\js\**;wwwroot\fonts\**" />
      <Content Include="@(_FrontendOutput)" Exclude="@(Content)" />
    </ItemGroup>
  </Target>

</Project>
