# Optional: nginx in front of osb, for serving the site publicly over HTTPS.
#
#   sudo apt install nginx certbot python3-certbot-nginx
#   sudo cp nginx-osb.conf.example /etc/nginx/sites-available/osb
#   sudo ln -s /etc/nginx/sites-available/osb /etc/nginx/sites-enabled/osb
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d storyboarder.xyz -d www.storyboarder.xyz   # adds HTTPS + redirect
#
# Then set ASPNETCORE_URLS=http://127.0.0.1:5000 in /etc/osb/osb.env, so Kestrel is only
# reachable through nginx, and run: sudo systemctl restart osb
server {
    listen 80;
    listen [::]:80;
    server_name storyboarder.xyz www.storyboarder.xyz;

    location / {
        proxy_pass         http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}
