# Settings for the osb service, read by systemd at every start. The first deploy copies
# this to /etc/osb/osb.env (readable by root only) and never overwrites it afterwards.
# After editing that file, apply the changes with:  sudo systemctl restart osb
#
# Any appsettings.json value can be overridden here by replacing ":" with "__"
# (API:ClientSecret -> API__ClientSecret). Wrap values containing spaces in "double quotes".

# Where Kestrel listens. 0.0.0.0 makes the site reachable from your LAN at http://<pi>:5000.
# Once a reverse proxy (nginx, Caddy, cloudflared) runs on the Pi, use http://127.0.0.1:5000.
ASPNETCORE_URLS=http://0.0.0.0:5000

# osu! OAuth application, from https://osu.ppy.sh/home/account/edit#oauth
API__ClientSecret=
#API__ClientID=11668
#API__RedirectURL=https://www.storyboarder.xyz/auth/Authorized

# The osb team members who review showcase submissions: osu! user IDs, separated by commas.
# Reviewers see "Review queue" in their account menu.
#Showcase__Reviewers=

# The SQLite database (showcase data and learners' progress). The service keeps it in
# /var/lib/osb, which deploys never touch; pi-install.sh backs it up to /var/backups/osb
# before each deploy. Only change this if you move the database elsewhere.
#ConnectionStrings__Osb="Data Source=/var/lib/osb/osb.db"

# Behind a TLS reverse proxy: lets the app redirect plain-http requests to https.
#ASPNETCORE_HTTPS_PORT=443

# Boards with 1 GB of RAM or less: the workstation GC uses noticeably less memory.
#DOTNET_gcServer=0
