@model HomeViewModel
@{
    var summary = Model.Summary;
    var slides = summary.Recent.Take(5).ToList();
    ViewData["Title"] = "";
    ViewData["Backdrop"] = slides.FirstOrDefault()?.CoverUrl;
    int maxMedium = summary.TopMediums.Count > 0 ? summary.TopMediums.Max(m => m.Count) : 1;
}

<section class="relative animate-fade-in overflow-hidden card px-6 py-7 sm:px-10 lg:pr-[25rem]">
    <h1 class="font-display text-3xl font-bold tracking-tight text-mint-50 sm:text-4xl">osu! Storyboarder Banquet</h1>
    <p class="mt-4 max-w-[62ch] leading-relaxed font-semibold text-mint-200">
        Welcome to our lovely banquet! Care to dine in and whet your insatiable appetite for visual wizardry on osu!?
        You can get started by checking out the <a href="/showcase">storyboard showcase</a>, or gander at some on the slideshow below or on the video player here.
        If you're here to learn how to storyboard and program, look no further than our <a href="/learn">learning resources</a>!
        And if you want to be a part of the storyboarding community, <a href="/community">click here to learn more</a>.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
        <a href="/learn" class="btn btn-primary">@Icons.Get("sparkles", "size-4") Start learning</a>
        <a href="/showcase" class="btn btn-outline">Browse the showcase</a>
    </div>
    <img src="~/images/mascot/hifumi.webp" alt="" width="640" height="696" class="pointer-events-none absolute -right-8 -bottom-36 hidden w-[23rem] rotate-[7deg] select-none lg:block">
</section>

<div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_26rem]">
    <div class="flex min-w-0 flex-col gap-8">
        @if (slides.Count > 0)
        {
            <section data-carousel aria-roledescription="carousel" aria-label="Recently showcased storyboards" class="group relative h-72 overflow-hidden rounded-card bg-charcoal-800 shadow-card sm:h-80">
                <div data-carousel-track class="flex h-full snap-x snap-mandatory overflow-x-auto scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                    @for (int i = 0; i < slides.Count; i++)
                    {
                        var set = slides[i];
                        <article data-carousel-slide aria-roledescription="slide" aria-label="@(i + 1) of @slides.Count" class="relative h-full w-full shrink-0 snap-start">
                            <img src="@set.CoverUrl" alt="" loading="@(i == 0 ? "eager" : "lazy")" class="absolute inset-0 size-full object-cover">
                            <div class="absolute inset-0 bg-gradient-to-t from-charcoal-800 via-charcoal-800/70 to-charcoal-800/10"></div>
                            <div class="relative flex h-full flex-col justify-end gap-1.5 px-6 pb-16 sm:px-8">
                                <p class="eyebrow">Showcased @set.ShowcasedOn.ToString("d MMMM yyyy")</p>
                                <h2 class="text-xl font-bold text-mint-50 sm:text-2xl">
                                    <a href="/showcase/detail?beatmapsetID=@set.Id" class="text-mint-50">@set.Artist - @set.Title</a>
                                </h2>
                                <p class="text-sm font-semibold text-mint-200">Storyboarded by <partial name="_Credits" model="set.Credits" /></p>
                            </div>
                        </article>
                    }
                </div>
                <div class="absolute inset-x-0 bottom-3 flex items-center justify-center gap-2">
                    <button type="button" data-carousel-prev class="rounded-md p-1 text-mint-200 opacity-70 transition hover:bg-black/20 hover:opacity-100" aria-label="Previous storyboard">@Icons.Get("arrow-left", "size-7")</button>
                    <div class="flex items-center gap-1.5">
                        @for (int i = 0; i < slides.Count; i++)
                        {
                            <button type="button" data-carousel-dot="@i" aria-label="Show storyboard @(i + 1)" class="h-1.5 w-4 rounded-full bg-mint-200/70 transition-all hover:bg-mint-400 aria-[current=true]:w-8 aria-[current=true]:bg-mint-400"></button>
                        }
                    </div>
                    <button type="button" data-carousel-next class="rounded-md p-1 text-mint-200 opacity-70 transition hover:bg-black/20 hover:opacity-100" aria-label="Next storyboard">@Icons.Get("arrow-right", "size-7")</button>
                </div>
            </section>
        }

        <section aria-labelledby="recent-title" class="flex flex-col gap-4">
            <div class="flex items-baseline justify-between gap-4">
                <h2 id="recent-title" class="section-title">Most recently added storyboards</h2>
                <a href="/showcase" class="text-sm font-semibold">See all @summary.StoryboardCount</a>
            </div>
            <div class="flex flex-col gap-3">
                @foreach (var set in summary.Recent)
                {
                    <partial name="_BeatmapListItem" model="set" />
                }
            </div>
        </section>
    </div>

    <aside class="flex min-w-0 flex-col gap-8">
        <section aria-labelledby="learn-title" class="relative overflow-hidden card p-6">
            <p class="eyebrow">osb! learn</p>
            <h2 id="learn-title" class="mt-1 text-xl font-bold text-mint-50">Learn to storyboard</h2>
            <p class="mt-2 text-sm leading-relaxed text-mint-200">
                Go from your first sprite to scripted particle effects. Short lessons, quizzes and hands-on exercises
                you solve right in the browser, with XP, levels and badges along the way.
            </p>
            <a href="/learn" class="btn btn-primary mt-5">Open the course</a>
            <img src="~/images/mascot/hifumi-shy.webp" alt="" width="400" height="711" class="pointer-events-none absolute -right-6 -bottom-28 w-28 opacity-90 select-none">
        </section>

        <section aria-labelledby="stats-title" class="card p-6">
            <h2 id="stats-title" class="section-title">The banquet so far</h2>
            <dl class="mt-4 grid grid-cols-2 gap-4">
                <div class="rounded-card bg-charcoal-700 p-4">
                    <dt class="text-xs font-semibold text-sage">Storyboards</dt>
                    <dd class="font-display text-3xl font-bold text-mint-50 tabular-nums">@summary.StoryboardCount</dd>
                </div>
                <div class="rounded-card bg-charcoal-700 p-4">
                    <dt class="text-xs font-semibold text-sage">Storyboarders</dt>
                    <dd class="font-display text-3xl font-bold text-mint-50 tabular-nums">@summary.StoryboarderCount</dd>
                </div>
            </dl>
            <h3 class="mt-5 text-sm font-bold text-mint-200">Most popular tools</h3>
            <ul class="mt-3 flex flex-col gap-2.5">
                @foreach (var medium in summary.TopMediums)
                {
                    <li>
                        <a href="/showcase?m=@Uri.EscapeDataString(medium.Medium)" class="flex items-center justify-between text-sm font-semibold text-mint-200">
                            <span>@medium.Medium</span><span class="text-sage tabular-nums">@medium.Count</span>
                        </a>
                        <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-charcoal-700">
                            <div class="h-full rounded-full bg-mint-400" style="width: @(100.0 * medium.Count / maxMedium)%"></div>
                        </div>
                    </li>
                }
            </ul>
        </section>

        @if (summary.FeaturedVideo is { } featured)
        {
            string featuredTitle = featured.Artist + " - " + featured.Title;
            <section aria-labelledby="playing-title" class="flex flex-col gap-3">
                <h2 id="playing-title" class="section-title">Now playing</h2>
                <partial name="_VideoFacade" model="(featured.VideoUrl, featuredTitle)" />
                <p class="text-sm text-sage">
                    <a href="/showcase/detail?beatmapsetID=@featured.Id" class="font-semibold">@featuredTitle</a>,
                    storyboarded by <partial name="_Credits" model="featured.Credits" />
                </p>
            </section>
        }

        <partial name="_Updates" />
    </aside>
</div>
