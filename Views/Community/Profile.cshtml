@model ProfileViewModel
@{
    var user = Model.User;
    var primary = user.PrimaryRole;
    var roles = user.Roles.OrderByDescending(r => r.Rank).ToList();
    var storyboards = Model.Profile.Storyboards;
    ViewData["Title"] = user.Username;
    ViewData["Description"] = $"{user.Username}'s storyboards on osu! Storyboarder Banquet.";
}

<article class="animate-fade-in">
    <header class="overflow-hidden rounded-card bg-charcoal-800 shadow-card">
        <img src="@Model.BannerUrl" alt="" class="h-40 w-full object-cover sm:h-56">
        <div class="flex flex-col gap-4 px-6 pb-6 sm:flex-row sm:items-end sm:px-8">
            <img src="@user.AvatarUrl" alt="" width="128" height="128" class="-mt-14 size-28 rounded-card border-4 border-charcoal-800 bg-charcoal-700 object-cover shadow-card sm:-mt-16 sm:size-32">
            <div class="flex min-w-0 flex-1 flex-col gap-2">
                <h1 class="truncate font-display text-3xl font-bold text-mint-50">@user.Username</h1>
                <div class="flex flex-wrap items-center gap-2 text-sm">
                    @if (primary != null)
                    {
                        <span class="rounded-full px-2.5 py-0.5 font-bold text-charcoal-950" style="background-color: @primary.Colour">@primary.Name</span>
                    }
                    else
                    {
                        <span class="rounded-full bg-charcoal-700 px-2.5 py-0.5 font-bold text-mint-200">Storyboarder</span>
                    }
                    @foreach (var role in roles.Skip(1))
                    {
                        <span class="inline-flex items-center gap-1.5 rounded-full border border-charcoal-500 px-2.5 py-0.5 font-semibold text-mint-200">
                            <span class="size-2 rounded-full" style="background-color: @role.Colour"></span>@role.Name
                        </span>
                    }
                    @if (Model.Osu?.Country?.Name is { } country)
                    {
                        <span class="inline-flex items-center gap-1.5 text-sage">
                            @if (Model.FlagUrl != null)
                            {
                                <img src="@Model.FlagUrl" alt="" width="20" height="14" class="h-3.5 w-5 rounded-sm object-cover">
                            }
                            @country
                        </span>
                    }
                </div>
            </div>
            <a href="@user.OsuProfileUrl" class="btn btn-outline self-start sm:self-end">osu! profile @Icons.Get("external", "size-4")</a>
        </div>
    </header>

    <section aria-labelledby="storyboards-title" class="mt-8 flex flex-col gap-4">
        <h2 id="storyboards-title" class="section-title">Storyboards by @user.Username</h2>
        @if (storyboards.Count == 0)
        {
            <p class="card p-6 text-sm text-sage">No showcased storyboards yet.</p>
        }
        else
        {
            <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
                @foreach (var set in storyboards)
                {
                    <partial name="_BeatmapCard" model="set" />
                }
            </div>
        }
    </section>
</article>
