@model ErrorViewModel
@{
    ViewData["Title"] = "Something broke";
}

<section class="mx-auto flex max-w-3xl animate-fade-in flex-col items-center gap-5 card px-6 py-10 text-center sm:px-12">
    <p class="eyebrow">Error @(Model?.StatusCode ?? 500)</p>
    <h1 class="font-display text-4xl font-bold text-mint-50">Bollocks!</h1>
    <img src="~/images/mascot/hifumi-scramble.webp" alt="A flustered Hifumi" width="306" height="306" class="w-56 rounded-card">
    <p class="max-w-[60ch] leading-relaxed text-mint-200">
        Oh dear. Something broke, and you've reached this page as you've hit some internal error or bug that just frolicked itself upon here.
        A bit awkward either way. Tell us on Discord what you were doing to get here so we can get that fixed up and doodly.
        But have a random storyboard button. The girls LOVE random storyboard buttons.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
        @if (Model?.RandomStoryboard != null)
        {
            <a href="/showcase/detail?beatmapsetID=@Model.RandomStoryboard.Id" class="btn btn-primary">@Icons.Get("sparkles", "size-4") Take me away!</a>
        }
        <a href="/" class="btn btn-outline">Back to the banquet</a>
    </div>
</section>
