@model ErrorViewModel
@{
    ViewData["Title"] = "Page not found";
}

<section class="mx-auto flex max-w-3xl animate-fade-in flex-col items-center gap-5 card px-6 py-10 text-center sm:px-12">
    <p class="eyebrow">Error 404</p>
    <h1 class="font-display text-4xl font-bold text-mint-50">Gadzooks!</h1>
    <img src="~/images/mascot/hifumi-uhoh.webp" alt="Hifumi, scared that you're here" width="500" height="333" class="w-full max-w-sm rounded-card">
    <div class="flex max-w-[60ch] flex-col gap-3 leading-relaxed text-mint-200">
        <p>
            You've reached here because the page at
            @if (!string.IsNullOrEmpty(Model?.RequestedPath)) { <code class="rounded bg-charcoal-950 px-1.5 py-0.5 text-gold-200">@Model.RequestedPath</code> } else { <text>this URL</text> }
            doesn't actually exist! Perhaps you should tread back to safer territories. Here. Have a random storyboard button on me.
        </p>
        <p class="text-sm text-sage">If you're absolutely confident that something <em>should</em> have been here, or you've stumbled upon a dead link, let us know on Discord.</p>
    </div>
    <div class="flex flex-wrap justify-center gap-3">
        @if (Model?.RandomStoryboard != null)
        {
            <a href="/showcase/detail?beatmapsetID=@Model.RandomStoryboard.Id" class="btn btn-primary">@Icons.Get("sparkles", "size-4") Take me away!</a>
        }
        <a href="/" class="btn btn-outline">Back to the banquet</a>
    </div>
</section>
