@model ShowcaseIndexViewModel
@{
    ViewData["Title"] = "Storyboard Showcase";
    ViewData["Description"] = "Storyboards handpicked by the osb community. Search by song, artist, mapper or storyboarder, or filter by tag and tool.";
    ViewData["Backdrop"] = Model.Results.Items.FirstOrDefault()?.CoverUrl;
    var results = Model.Results;
}

<header class="flex animate-fade-in flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div class="flex flex-col gap-2">
        <p class="eyebrow">Showcase</p>
        <h1 class="font-display text-3xl font-bold tracking-tight text-mint-50 sm:text-4xl">Storyboard Showcase</h1>
        <p class="max-w-[65ch] text-mint-200">
            Storyboards handpicked by the community. Search by song, artist, mapper or storyboarder,
            or filter by what makes them special.
        </p>
    </div>
    <a href="/showcase/submit" class="btn btn-outline shrink-0 self-start sm:self-auto">@Icons.Get("upload", "size-4") Submit a storyboard</a>
</header>

<form action="/showcase" method="get" role="search" class="mt-6 flex gap-2">
    @if (!string.IsNullOrEmpty(Model.Tag)) { <input type="hidden" name="t" value="@Model.Tag"> }
    @if (!string.IsNullOrEmpty(Model.Medium)) { <input type="hidden" name="m" value="@Model.Medium"> }
    <label for="showcase-search" class="sr-only">Search storyboards</label>
    <div class="relative flex-1">
        <input id="showcase-search" name="s" value="@Model.Query" type="search" placeholder="Song, artist, mapper or storyboarder" class="input h-11 pl-10">
        <span class="pointer-events-none absolute top-1/2 left-3.5 -translate-y-1/2 text-sage">@Icons.Get("search", "size-4")</span>
    </div>
    <button type="submit" class="btn btn-primary h-11">Search</button>
</form>

<div class="mt-5 flex flex-col gap-3">
    <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter by tag">
        <a href="@Model.Url(tag: null)" class="chip" aria-current="@(string.IsNullOrEmpty(Model.Tag) ? "true" : null)">All tags</a>
        @foreach (var tag in Model.Tags)
        {
            <a href="@Model.Url(tag: tag.Slug)" class="chip" aria-current="@(tag.Slug == Model.Tag ? "true" : null)">
                <img src="/images/showcase/tags.svg#@tag.Slug" alt="" width="20" height="20" class="size-5">@tag.Name
            </a>
        }
    </div>
    <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter by tool">
        <span class="mr-1 text-xs font-semibold text-sage">Made with</span>
        <a href="@Model.Url(medium: null)" class="chip text-xs" aria-current="@(string.IsNullOrEmpty(Model.Medium) ? "true" : null)">Any tool</a>
        @foreach (var medium in Model.Mediums)
        {
            <a href="@Model.Url(medium: medium)" class="chip text-xs" aria-current="@(medium == Model.Medium ? "true" : null)">@medium</a>
        }
    </div>
</div>

<div class="mt-6 flex items-center justify-between gap-4 text-sm text-sage">
    <p>
        <span class="font-semibold text-mint-200">@results.Total</span> @(results.Total == 1 ? "storyboard" : "storyboards")
        @if (!string.IsNullOrWhiteSpace(Model.Query)) { <text>matching "<span class="font-semibold text-mint-200">@Model.Query</span>"</text> }
    </p>
    @if (Model.IsFiltered)
    {
        <a href="/showcase" class="font-semibold">Clear filters</a>
    }
</div>

@if (results.Items.Count == 0)
{
    <div class="mt-8 flex flex-col items-center gap-4 card px-6 py-12 text-center">
        <img src="~/images/mascot/hifumi-notfound.webp" alt="" width="257" height="317" class="w-40 -scale-x-100">
        <p class="text-lg font-bold text-mint-50">I'm sorry, I can't find anything.</p>
        <p class="text-sm text-sage">Try another search, or <a href="/showcase">browse every storyboard</a>.</p>
    </div>
}
else
{
    <div class="mt-4 grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
        @foreach (var set in results.Items)
        {
            <partial name="_BeatmapCard" model="set" />
        }
    </div>

    @if (results.PageCount > 1)
    {
        <nav aria-label="Pages" class="mt-10 flex flex-wrap items-center justify-center gap-1.5">
            @if (results.Page > 1)
            {
                <a href="@Model.Url(page: results.Page - 1)" class="btn btn-ghost" rel="prev">@Icons.Get("arrow-left", "size-5") Previous</a>
            }
            @for (int p = 1; p <= results.PageCount; p++)
            {
                <a href="@Model.Url(page: p)" aria-current="@(p == results.Page ? "page" : null)"
                   class="flex size-10 items-center justify-center rounded-md font-semibold text-mint-200 transition hover:bg-charcoal-700 hover:no-underline aria-[current=page]:bg-mint-400 aria-[current=page]:text-charcoal-950">@p</a>
            }
            @if (results.Page < results.PageCount)
            {
                <a href="@Model.Url(page: results.Page + 1)" class="btn btn-ghost" rel="next">Next @Icons.Get("arrow-right", "size-5")</a>
            }
        </nav>
    }
}
