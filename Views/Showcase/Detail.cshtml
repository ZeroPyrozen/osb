@model ShowcaseDetailViewModel
@{
    var set = Model.Set;
    var credits = set.Credits.ToList();
    ViewData["Title"] = $"{set.Artist} - {set.Title}";
    ViewData["Description"] = $"{set.Artist} - {set.Title}, storyboarded by {string.Join(", ", credits.Select(c => c.Username))}. OSB level {set.OsbLevel}, made with {set.Medium}.";
    ViewData["Backdrop"] = set.CoverUrl;
    var tags = set.Tags.OrderByDescending(t => t.Rating).ThenBy(t => t.Name).ToList();
    string videoTitle = $"{set.Artist} - {set.Title}";
}

<nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-1.5 text-sm text-sage">
    <a href="/showcase" class="font-semibold">Showcase</a>
    @Icons.Get("chevron-right", "size-4")
    <span class="truncate" aria-current="page">@set.Title</span>
</nav>

<article class="animate-fade-in">
    <header class="relative overflow-hidden rounded-card bg-charcoal-800 shadow-card">
        <img src="@set.CoverUrl" alt="" width="900" height="250" class="h-56 w-full object-cover sm:h-72">
        <div class="absolute inset-0 bg-gradient-to-t from-charcoal-800 via-charcoal-800/50 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 flex flex-col gap-1 p-6 sm:p-8">
            <p class="eyebrow">Showcased @set.ShowcasedOn.ToString("d MMMM yyyy")</p>
            <h1 class="font-display text-2xl font-bold text-mint-50 sm:text-4xl">@set.Title</h1>
            <p class="text-lg font-semibold text-mint-200">@set.Artist</p>
        </div>
    </header>

    <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_21rem]">
        <div class="flex min-w-0 flex-col gap-6">
            @if (!string.IsNullOrEmpty(set.VideoUrl))
            {
                <section aria-label="Video" class="flex flex-col gap-3">
                    <partial name="_VideoFacade" model="(set.VideoUrl, videoTitle)" />
                </section>
            }

            <section aria-labelledby="tags-title" class="card p-6">
                <h2 id="tags-title" class="section-title">Tags</h2>
                <p class="mt-1 text-sm text-sage">Each tag adds to the OSB level. Pick one to see similar storyboards.</p>
                <ul class="mt-4 grid gap-2 sm:grid-cols-2">
                    @foreach (var tag in tags)
                    {
                        <li>
                            <a href="/showcase?t=@tag.Slug" class="flex items-center gap-3 rounded-card bg-charcoal-700 px-3 py-2 font-semibold text-mint-200 transition hover:bg-charcoal-600 hover:no-underline">
                                <img src="/images/showcase/tags.svg#@tag.Slug" alt="" width="36" height="36" class="size-9">
                                <span class="flex-1">@tag.Name</span>
                                <span class="text-sm text-gold-300 tabular-nums">+@tag.Rating</span>
                            </a>
                        </li>
                    }
                </ul>
            </section>
        </div>

        <aside class="flex flex-col gap-6">
            <section aria-label="OSB level" class="flex items-center gap-4 card p-6">
                <div class="size-16 shrink-0 motion-safe:animate-[spin_14s_linear_infinite]">
                    <img src="~/images/showcase/osb-level.png" alt="" class="size-16">
                </div>
                <div>
                    <p class="eyebrow">OSB level</p>
                    <p class="font-display text-4xl font-bold text-gold-300 tabular-nums">@set.OsbLevel</p>
                </div>
            </section>

            <section aria-labelledby="credits-title" class="card p-6">
                <h2 id="credits-title" class="section-title">Storyboarded by</h2>
                <ul class="mt-4 flex flex-col gap-3">
                    @foreach (var person in credits)
                    {
                        <li>
                            <a href="/community/profile?userID=@person.Id" class="flex items-center gap-3 font-semibold text-mint-200">
                                <img src="@person.AvatarUrl" alt="" width="40" height="40" loading="lazy" class="size-10 rounded-full bg-charcoal-700 object-cover">
                                @person.Username
                            </a>
                        </li>
                    }
                </ul>

                <dl class="mt-6 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 border-t border-charcoal-600 pt-5 text-sm">
                    <dt class="text-sage">Hosted by</dt>
                    <dd><a href="@set.Host.OsuProfileUrl" class="font-semibold">@set.Host.Username</a></dd>
                    <dt class="text-sage">Made with</dt>
                    <dd><a href="/showcase?m=@Uri.EscapeDataString(set.Medium)" class="font-semibold">@set.Medium</a></dd>
                    <dt class="text-sage">Submitted</dt>
                    <dd class="text-mint-200">@set.SubmittedOn.ToString("d MMMM yyyy")</dd>
                    <dt class="text-sage">Showcased</dt>
                    <dd class="text-mint-200">@set.ShowcasedOn.ToString("d MMMM yyyy")</dd>
                </dl>

                <div class="mt-6 flex flex-col gap-2">
                    <a href="@set.OsuPageUrl" class="btn btn-primary">View on osu! @Icons.Get("external", "size-4")</a>
                    <a href="osu://s/@set.Id" class="btn btn-outline" title="Opens the beatmap in osu! (osu!direct needs osu!supporter)">@Icons.Get("download", "size-4") Open in osu!direct</a>
                </div>
            </section>
        </aside>
    </div>

    @if (Model.Related.Count > 0)
    {
        <section aria-labelledby="related-title" class="mt-10 flex flex-col gap-4">
            <h2 id="related-title" class="section-title">More by @(credits.Count == 1 ? credits[0].Username : "these storyboarders")</h2>
            <div class="grid gap-3 lg:grid-cols-2">
                @foreach (var related in Model.Related)
                {
                    <partial name="_BeatmapListItem" model="related" />
                }
            </div>
        </section>
    }
</article>
