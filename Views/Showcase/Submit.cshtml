@{
    ViewData["Title"] = "Submit a storyboard";
}

<section class="relative mx-auto max-w-3xl animate-fade-in overflow-hidden card px-6 py-10 sm:px-10">
    <p class="eyebrow">Showcase</p>
    <h1 class="mt-1 font-display text-3xl font-bold text-mint-50">Submit a storyboard</h1>
    <p class="mt-4 max-w-[52ch] leading-relaxed text-mint-200">
        Submitting from the site isn't open yet. Until it is, share your storyboard in the osb Discord server
        and the team will take a look. Include a link to the beatmapset, a video if you have one, and which tool you made it with.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
        <a href="https://discord.gg/B8NX7YW" class="btn btn-primary">@Icons.Get("discord", "size-4") Share it on Discord</a>
        <a href="/learn" class="btn btn-outline">Learn to storyboard first</a>
    </div>
    <img src="~/images/mascot/hifumi-stylish.webp" alt="" width="640" height="524" class="pointer-events-none absolute -right-16 -bottom-10 hidden w-72 select-none sm:block">
</section>
