@model osb.Learn.LearnUnit
@using osb.Learn
@{
    var unit = Model;
    var module = unit.Module;
    ViewData["Title"] = $"{unit.Title} · {module.Title}";
    ViewData["Description"] = unit.Summary ?? module.Summary;
    bool isExercise = unit.Type == UnitType.Exercise;
    bool showToc = unit.Type == UnitType.Lesson && unit.Headings.Count >= 2;
    string gridClass = showToc
        ? "lg:grid-cols-[15rem_minmax(0,1fr)] xl:grid-cols-[15rem_minmax(0,1fr)_12rem]"
        : "lg:grid-cols-[15rem_minmax(0,1fr)]";
}
@section Head { <partial name="_LearnHead" /> }

<nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-1.5 text-sm text-sage">
    <a href="/learn" class="font-semibold">Learn</a>
    @Icons.Get("chevron-right", "size-4")
    <a href="@module.Url" class="font-semibold">@module.Title</a>
    @Icons.Get("chevron-right", "size-4")
    <span aria-current="page">Unit @unit.Number of @module.Units.Count</span>
</nav>

<div class="grid gap-8 @gridClass">
    <aside class="hidden lg:block" aria-label="Units in this module">
        <div class="sticky top-24 flex flex-col gap-3" data-module="@module.Slug">
            <a href="@module.Url" class="eyebrow hover:no-underline">Module @module.Number · @module.Path.Level</a>
            <p class="-mt-1 font-bold text-mint-50">@module.Title</p>
            <span class="flex items-center gap-2 text-xs text-sage">
                <span class="h-1.5 flex-1 overflow-hidden rounded-full bg-charcoal-700"><span class="block h-full rounded-full @LearnStyles.Bar(module.Path.Slug) transition-all duration-700" data-bar style="width: 0%"></span></span>
                <span class="tabular-nums" data-count>0 / @module.Units.Count</span>
            </span>
            <ol class="flex flex-col gap-0.5">
                @foreach (var other in module.Units)
                {
                    bool current = other.Id == unit.Id;
                    <li data-unit="@other.Id" class="group">
                        <a href="@other.Url" aria-current="@(current ? "page" : null)"
                           class="flex items-start gap-2.5 rounded-md px-2 py-1.5 text-sm text-mint-200 transition hover:bg-charcoal-800 hover:no-underline aria-[current=page]:bg-charcoal-800 aria-[current=page]:font-bold aria-[current=page]:text-mint-50">
                            <span class="mt-0.5 flex size-4 shrink-0 items-center justify-center rounded-full border border-charcoal-500 group-data-done:border-mint-400 group-data-done:bg-mint-400 group-data-done:text-charcoal-950">
                                <span class="hidden group-data-done:block">@Icons.Get("check", "size-3")</span>
                            </span>
                            <span>@other.Title</span>
                        </a>
                    </li>
                }
            </ol>
        </div>
    </aside>

    <div class="min-w-0">
        <header class="animate-fade-in">
            <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-sage">
                <span class="flex items-center gap-1.5 font-semibold">@Icons.Get(unit.TypeIcon, "size-4") @unit.TypeLabel</span>
                <span class="flex items-center gap-1.5">@Icons.Get("clock", "size-4") @unit.Minutes min</span>
                <span class="font-semibold text-gold-300">+@unit.Xp XP</span>
                <span data-unit="@unit.Id" class="group"><span class="hidden items-center gap-1 rounded-full bg-mint-400/15 px-2 py-0.5 text-xs font-bold text-mint-300 group-data-done:flex">@Icons.Get("check", "size-3.5") Completed</span></span>
            </p>
            <h1 class="mt-2 font-display text-3xl font-bold text-mint-50">@unit.Title</h1>
        </header>

        @if (!string.IsNullOrWhiteSpace(unit.Html))
        {
            <article class="prose prose-osb mt-6 @(isExercise ? "max-w-none" : "")">@Html.Raw(unit.Html)</article>
        }

        @if (unit.Type == UnitType.Lesson)
        {
            <div data-unit="@unit.Id" class="group mt-10 flex flex-wrap items-center justify-between gap-4 rounded-card border border-charcoal-600 bg-charcoal-900 p-5">
                <p class="text-sm text-mint-200">
                    <span class="group-data-done:hidden">Finished reading? Mark the lesson complete to earn <strong class="text-gold-300">@unit.Xp XP</strong>.</span>
                    <span class="hidden group-data-done:inline">You've completed this lesson.</span>
                </p>
                <div class="flex flex-wrap gap-2">
                    <button type="button" data-complete-unit="@unit.Id" data-next="@unit.Next?.Url" class="btn btn-primary group-data-done:hidden">Complete and continue</button>
                    @if (unit.Next != null)
                    {
                        <a href="@unit.Next.Url" class="btn btn-outline hidden group-data-done:inline-flex">Next: @unit.Next.Title</a>
                    }
                </div>
            </div>
        }
        else if (unit.Type == UnitType.Quiz && unit.Quiz != null)
        {
            <form data-quiz data-unit-id="@unit.Id" data-pass="@unit.Quiz.Pass" class="mt-6 flex flex-col gap-5">
                <script type="application/json" data-quiz-key>[@string.Join(",", unit.Quiz.Questions.Select(q => q.Answer))]</script>
                <p class="text-sm text-sage">@unit.Quiz.Questions.Count questions. Get @unit.Quiz.Pass right to pass; a perfect score earns bonus XP.</p>
                @for (int i = 0; i < unit.Quiz.Questions.Count; i++)
                {
                    var question = unit.Quiz.Questions[i];
                    <fieldset data-question class="group rounded-card border border-charcoal-600 bg-charcoal-800 p-5 transition data-[state=correct]:border-mint-400 data-[state=wrong]:border-danger">
                        <legend class="sr-only">Question @(i + 1)</legend>
                        <p class="font-bold text-mint-50"><span class="text-sage">@(i + 1).</span> @Html.Raw(question.Prompt)</p>
                        <div class="mt-3 flex flex-col gap-2">
                            @for (int j = 0; j < question.Choices.Count; j++)
                            {
                                <label class="flex cursor-pointer items-start gap-3 rounded-md border border-charcoal-600 px-3 py-2 text-sm text-mint-100 transition hover:bg-charcoal-700 has-checked:border-mint-400 group-data-[state=wrong]:has-checked:border-danger data-answer:border-mint-400 data-answer:bg-mint-400/10 [&_code]:rounded [&_code]:bg-charcoal-950 [&_code]:px-1 [&_code]:text-gold-200">
                                    <input type="radio" name="q@(i)" value="@j" class="mt-0.5 accent-mint-400">
                                    <span>@Html.Raw(question.Choices[j])</span>
                                </label>
                            }
                        </div>
                        <div data-explanation hidden class="prose prose-osb mt-4 border-t border-charcoal-600 pt-3 text-sm">
                            <p class="!mb-1 font-bold"><span class="hidden text-mint-300 group-data-[state=correct]:inline">Correct.</span><span class="hidden text-danger group-data-[state=wrong]:inline">Not quite.</span></p>
                            @Html.Raw(question.Explanation)
                        </div>
                    </fieldset>
                }
                <div class="flex flex-wrap items-center gap-3">
                    <button type="submit" class="btn btn-primary">Check answers</button>
                    <button type="button" data-quiz-retry hidden class="btn btn-outline">Try again</button>
                </div>
                <div data-quiz-result aria-live="polite"></div>
                @if (unit.Next != null)
                {
                    <div data-unit="@unit.Id" class="group"><a href="@unit.Next.Url" class="btn btn-outline hidden group-data-done:inline-flex">Next: @unit.Next.Title</a></div>
                }
            </form>
        }
        else if (isExercise)
        {
            <div data-exercise class="mt-6">
                <script type="application/json" data-exercise-config>@Html.Raw(LearnStyles.ExerciseJson(unit))</script>
                <div data-exercise-workspace>
                    <p class="rounded-card border border-charcoal-600 bg-charcoal-900 p-5 text-sm text-sage">Loading the editor…</p>
                </div>
                <noscript><p class="mt-3 text-sm text-gold-200">Exercises run in your browser, so they need JavaScript.</p></noscript>
            </div>
        }

        <nav aria-label="Previous and next unit" class="mt-10 grid gap-3 border-t border-charcoal-600 pt-6 sm:grid-cols-2">
            @if (unit.Previous != null)
            {
                <a href="@unit.Previous.Url" class="flex flex-col rounded-card p-3 transition hover:bg-charcoal-800 hover:no-underline">
                    <span class="text-xs text-sage">Previous</span>
                    <span class="font-semibold text-mint-200">@unit.Previous.Title</span>
                </a>
            }
            else
            {
                <span></span>
            }
            @if (unit.Next != null)
            {
                <a href="@unit.Next.Url" class="flex flex-col rounded-card p-3 text-right transition hover:bg-charcoal-800 hover:no-underline">
                    <span class="text-xs text-sage">Next@(unit.Next.Module != module ? $" · {unit.Next.Module.Title}" : "")</span>
                    <span class="font-semibold text-mint-200">@unit.Next.Title</span>
                </a>
            }
            else
            {
                <a href="/learn/progress" class="flex flex-col rounded-card p-3 text-right transition hover:bg-charcoal-800 hover:no-underline">
                    <span class="text-xs text-sage">You reached the end</span>
                    <span class="font-semibold text-mint-200">See your achievements</span>
                </a>
            }
        </nav>
    </div>

    @if (showToc)
    {
        <nav aria-label="On this page" class="hidden xl:block">
            <div class="sticky top-24 flex flex-col gap-2 text-sm">
                <p class="eyebrow">On this page</p>
                @foreach (var heading in unit.Headings)
                {
                    <a href="#@heading.Id" class="text-sage hover:text-mint-200">@heading.Text</a>
                }
            </div>
        </nav>
    }
</div>

@section Scripts { <partial name="_LearnScripts" /> }
