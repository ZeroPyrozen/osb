@model Beatmapset
@* Showcase grid card. The title link covers the card; credit and tag links sit above it. *@
<article class="group relative flex flex-col overflow-hidden rounded-card bg-charcoal-800 shadow-card transition duration-300 hover:-translate-y-0.5">
    <div class="relative aspect-[400/140] overflow-hidden bg-charcoal-700">
        <img src="@Model.CardUrl" alt="" width="400" height="140" loading="lazy" class="size-full object-cover transition duration-500 group-hover:scale-105">
        <span class="absolute top-2 right-2 rounded-full bg-night/80 px-2.5 py-0.5 text-xs font-bold text-gold-300 backdrop-blur" title="OSB level: the sum of this storyboard's tag ratings">OSB LVL @Model.OsbLevel</span>
    </div>
    <div class="flex flex-1 flex-col gap-1.5 p-4">
        <h3 class="leading-snug font-bold">
            <a href="/showcase/detail?beatmapsetID=@Model.Id" class="text-mint-50 after:absolute after:inset-0 hover:no-underline">@Model.Title</a>
        </h3>
        <p class="text-sm text-sage">@Model.Artist</p>
        <p class="text-sm">Storyboarded by <partial name="_Credits" model="Model.Credits" /></p>
        <div class="mt-auto flex items-end justify-between gap-3 pt-3">
            <div class="relative z-10 flex flex-wrap gap-1">
                @foreach (var tag in Model.Tags.OrderByDescending(t => t.Rating).ThenBy(t => t.Name))
                {
                    <a href="/showcase?t=@tag.Slug" title="@tag.Name" class="rounded-md p-0.5 transition hover:bg-charcoal-700">
                        <img src="/images/showcase/tags.svg#@tag.Slug" alt="@tag.Name" width="24" height="24" class="size-6">
                    </a>
                }
            </div>
            <span class="shrink-0 rounded-md bg-charcoal-700 px-2 py-0.5 text-xs font-semibold text-sage" title="Made with">@Model.Medium</span>
        </div>
    </div>
</article>
